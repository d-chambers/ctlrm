{
  "name": "ctlrm-workbench-assets",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check ../src/ctlrm/web/static/app.js && prettier --check build.mjs package.json ../src/ctlrm/web/static/app.js ../src/ctlrm/web/static/app.css ../src/ctlrm/web/static/index.html",
    "format": "prettier --write build.mjs package.json ../src/ctlrm/web/static/app.js ../src/ctlrm/web/static/app.css ../src/ctlrm/web/static/index.html"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
